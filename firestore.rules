rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function socialTaskAwardLinked(userId, submissionId) {
      let submissionPath = /databases/$(database)/documents/socialTaskSubmissions/$(submissionId);
      return signedIn()
        && submissionId is string
        && exists(submissionPath)
        && get(submissionPath).data.userId == userId
        && get(submissionPath).data.status == 'Pending'
        && getAfter(submissionPath).data.status == 'Approved'
        && getAfter(submissionPath).data.reviewedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.lastSocialTaskSubmissionId == submissionId
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.reputationPoints
          == getAfter(/databases/$(database)/documents/socialTaskBalances/$(userId)).data.points
        && existsAfter(/databases/$(database)/documents/reputationRewards/$(submissionId));
    }

    function staffAwardingSocialTask(userId) {
      let submissionId = request.resource.data.lastSocialTaskSubmissionId;
      let submissionPath = /databases/$(database)/documents/socialTaskSubmissions/$(submissionId);
      let balancePath = /databases/$(database)/documents/socialTaskBalances/$(userId);
      return isStaff()
        && userId != request.auth.uid
        && resource.data.role == 'member'
        && request.resource.data.diff(resource.data).affectedKeys().hasAll([
          'reputationPoints', 'reputationUpdatedAt', 'lastSocialTaskSubmissionId'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reputationPoints', 'reputationUpdatedAt', 'lastSocialTaskSubmissionId'
        ])
        && submissionId is string
        && exists(submissionPath)
        && get(submissionPath).data.userId == userId
        && get(submissionPath).data.status == 'Pending'
        && getAfter(submissionPath).data.status == 'Approved'
        && getAfter(submissionPath).data.reviewedBy == request.auth.uid
        && getAfter(submissionPath).data.reviewedAt == request.time
        && exists(balancePath)
        && get(balancePath).data.points == resource.data.get('reputationPoints', 0)
        && request.resource.data.reputationPoints
          == get(balancePath).data.points + get(submissionPath).data.tokenReward
        && getAfter(balancePath).data.points == request.resource.data.reputationPoints
        && request.resource.data.reputationUpdatedAt == request.time
        && existsAfter(/databases/$(database)/documents/reputationRewards/$(submissionId));
    }

    function staffUpdatingSocialTaskBalance(userId) {
      let submissionId = getAfter(/databases/$(database)/documents/users/$(userId)).data.lastSocialTaskSubmissionId;
      let submissionPath = /databases/$(database)/documents/socialTaskSubmissions/$(submissionId);
      return isStaff()
        && submissionId is string
        && exists(submissionPath)
        && get(submissionPath).data.userId == userId
        && get(submissionPath).data.status == 'Pending'
        && getAfter(submissionPath).data.status == 'Approved'
        && getAfter(submissionPath).data.reviewedBy == request.auth.uid
        && getAfter(submissionPath).data.reviewedAt == request.time
        && get(/databases/$(database)/documents/users/$(userId)).data.reputationPoints == resource.data.points
        && request.resource.data.points == resource.data.points + get(submissionPath).data.tokenReward
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.reputationPoints == request.resource.data.points
        && existsAfter(/databases/$(database)/documents/reputationRewards/$(submissionId));
    }

    function announcementFieldsValid(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 4000
        && data.category in ['Guild update', 'Events', 'Opportunities', 'Community', 'Important']
        && data.status in ['Draft', 'Scheduled', 'Published', 'Archived']
        && (data.publishAt == null || data.publishAt is timestamp)
        && (data.status != 'Scheduled' || (data.publishAt is timestamp && data.publishAt > request.time))
        && (data.status != 'Published' || (data.publishAt is timestamp && data.publishAt <= request.time))
        && (data.status == 'Scheduled' || data.status == 'Published' || data.publishAt == null);
    }

    function otherConversationParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.role == 'member';
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'professionalTitle', 'workType', 'experienceYears',
          'skills', 'location', 'bio', 'interests', 'websiteUrl',
          'linkedinUrl', 'githubUrl', 'twitterUrl', 'discordHandle',
          'showInMemberDirectory', 'showOnLeaderboard', 'reputationPoints'
        ])
        && request.resource.data.showInMemberDirectory is bool
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['showOnLeaderboard'])
          || request.resource.data.showOnLeaderboard is bool)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reputationPoints'])
          || (request.resource.data.reputationPoints is number
            && request.resource.data.reputationPoints >= 0
            && request.resource.data.reputationPoints == resource.data.get('reputationPoints', 0)))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.professionalTitle is string
        && request.resource.data.professionalTitle.size() <= 180
        && request.resource.data.workType is string
        && request.resource.data.workType.size() <= 100
        && request.resource.data.experienceYears is string
        && request.resource.data.experienceYears.size() <= 3
        && request.resource.data.skills is string
        && request.resource.data.skills.size() <= 500
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 180
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 1000
        && request.resource.data.interests is string
        && request.resource.data.interests.size() <= 500
        && request.resource.data.websiteUrl is string
        && request.resource.data.websiteUrl.size() <= 180
        && request.resource.data.linkedinUrl is string
        && request.resource.data.linkedinUrl.size() <= 180
        && request.resource.data.githubUrl is string
        && request.resource.data.githubUrl.size() <= 180
        && request.resource.data.twitterUrl is string
        && request.resource.data.twitterUrl.size() <= 180
        && request.resource.data.discordHandle is string
        && request.resource.data.discordHandle.size() <= 100
      ) || (
        staffAwardingSocialTask(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reputationPoints', 'reputationUpdatedAt', 'lastSocialTaskSubmissionId'
        ])
        && request.resource.data.lastSocialTaskSubmissionId is string
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if (
          isAdmin()
          && request.resource.data.keys().hasOnly([
            'type', 'title', 'body', 'href', 'actorName', 'sourceId', 'createdAt', 'readAt'
          ])
          && request.resource.data.type == 'reputation'
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 300
          && request.resource.data.href == '/member/leaderboard'
          && request.resource.data.actorName == 'The Monarch Guild'
          && request.resource.data.sourceId is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.readAt == null
        ) || (
          signedIn()
          && userId != request.auth.uid
          && request.resource.data.keys().hasOnly([
            'type', 'title', 'body', 'href', 'actorName', 'sourceId', 'sourceMessageId', 'createdAt', 'readAt'
          ])
          && request.resource.data.type == 'message'
          && request.resource.data.title == 'New message'
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 140
          && request.resource.data.actorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
          && request.resource.data.href == '/member/messages?conversation=' + request.resource.data.sourceId
          && request.resource.data.sourceId is string
          && request.resource.data.sourceMessageId is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.readAt == null
          && userId in getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.sourceId)).data.participants
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.sourceId)).data.participants
          && getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.sourceId)/messages/$(request.resource.data.sourceMessageId)).data.senderId == request.auth.uid
          && getAfter(/databases/$(database)/documents/conversations/$(request.resource.data.sourceId)/messages/$(request.resource.data.sourceMessageId)).data.createdAt == request.time
        );
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.showInMemberDirectory == true
        && request.resource.data.keys().hasOnly([
          'displayName', 'professionalTitle', 'workType', 'experienceYears',
          'skills', 'location', 'bio', 'interests', 'websiteUrl',
          'linkedinUrl', 'githubUrl', 'twitterUrl', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.professionalTitle is string
        && request.resource.data.professionalTitle.size() <= 180
        && request.resource.data.workType is string
        && request.resource.data.workType.size() <= 100
        && request.resource.data.experienceYears is string
        && request.resource.data.experienceYears.size() <= 3
        && request.resource.data.skills is list
        && request.resource.data.skills.size() <= 30
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 180
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 1000
        && request.resource.data.interests is string
        && request.resource.data.interests.size() <= 500
        && request.resource.data.websiteUrl is string
        && request.resource.data.websiteUrl.size() <= 180
        && request.resource.data.linkedinUrl is string
        && request.resource.data.linkedinUrl.size() <= 180
        && request.resource.data.githubUrl is string
        && request.resource.data.githubUrl.size() <= 180
        && request.resource.data.twitterUrl is string
        && request.resource.data.twitterUrl.size() <= 180
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /socialTaskBalances/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isStaff();
      allow create: if (isOwner(userId) || isAdmin())
        && request.resource.data.keys().hasOnly(['points', 'displayName', 'showOnLeaderboard', 'updatedAt'])
        && request.resource.data.points == getAfter(/databases/$(database)/documents/users/$(userId)).data.get('reputationPoints', 0)
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(userId)).data.displayName
        && request.resource.data.showOnLeaderboard == getAfter(/databases/$(database)/documents/users/$(userId)).data.showOnLeaderboard
        && request.resource.data.updatedAt == request.time;
      allow update: if (
        (isOwner(userId) || isAdmin())
        && request.resource.data.keys().hasOnly(['points', 'displayName', 'showOnLeaderboard', 'updatedAt'])
        && request.resource.data.points == getAfter(/databases/$(database)/documents/users/$(userId)).data.get('reputationPoints', 0)
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(userId)).data.displayName
        && request.resource.data.showOnLeaderboard == getAfter(/databases/$(database)/documents/users/$(userId)).data.showOnLeaderboard
        && request.resource.data.updatedAt == request.time
      ) || (
        staffUpdatingSocialTaskBalance(userId)
        && request.resource.data.keys().hasOnly(['points', 'displayName', 'showOnLeaderboard', 'updatedAt'])
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.showOnLeaderboard == resource.data.showOnLeaderboard
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if false;
    }

    match /publicLeaderboard/{userId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        isOwner(userId)
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.showOnLeaderboard == true
        && request.resource.data.keys().hasOnly(['displayName', 'points', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(userId)).data.displayName
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && request.resource.data.points == getAfter(/databases/$(database)/documents/users/$(userId)).data.reputationPoints
        && request.resource.data.updatedAt == request.time
      ) || (
        socialTaskAwardLinked(userId, getAfter(/databases/$(database)/documents/users/$(userId)).data.lastSocialTaskSubmissionId)
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.showOnLeaderboard == true
        && request.resource.data.keys().hasOnly(['displayName', 'points', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/socialTaskBalances/$(userId)).data.displayName
        && request.resource.data.points is number
        && request.resource.data.points == getAfter(/databases/$(database)/documents/socialTaskBalances/$(userId)).data.points
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin() || (
        isOwner(userId)
        && getAfter(/databases/$(database)/documents/users/$(userId)).data.showOnLeaderboard == false
      );
    }

    match /reputationRewards/{rewardId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        isStaff()
        && request.resource.data.keys().hasAll([
          'userId', 'memberName', 'title', 'category', 'points',
          'note', 'awardedBy', 'createdAt', 'taskSubmissionId'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'memberName', 'title', 'category', 'points',
          'note', 'awardedBy', 'createdAt', 'taskSubmissionId'
        ])
        && request.resource.data.taskSubmissionId is string
        && rewardId == request.resource.data.taskSubmissionId
        && socialTaskAwardLinked(request.resource.data.userId, request.resource.data.taskSubmissionId)
        && request.resource.data.userId is string
        && request.resource.data.memberName is string
        && request.resource.data.memberName == get(/databases/$(database)/documents/socialTaskBalances/$(request.resource.data.userId)).data.displayName
        && request.resource.data.title == get(/databases/$(database)/documents/socialTaskSubmissions/$(request.resource.data.taskSubmissionId)).data.taskTitle
        && request.resource.data.category == 'Social task'
        && request.resource.data.points == get(/databases/$(database)/documents/socialTaskSubmissions/$(request.resource.data.taskSubmissionId)).data.tokenReward
        && request.resource.data.note == getAfter(/databases/$(database)/documents/socialTaskSubmissions/$(request.resource.data.taskSubmissionId)).data.reviewNote
        && request.resource.data.awardedBy is string
        && request.resource.data.awardedBy.size() <= 100
        && request.resource.data.createdAt == request.time
      );
      allow update, delete: if false;
    }

    match /socialTasks/{taskId} {
      allow read: if isAdmin() || isStaff() || (
        signedIn() && resource.data.status == 'Active'
      );
      allow create: if (isAdmin() || isStaff())
        && request.resource.data.keys().hasAll([
          'title', 'description', 'category', 'platform', 'actionUrl',
          'tokenReward', 'status', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'platform', 'actionUrl',
          'tokenReward', 'status', 'createdBy', 'createdByName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1500
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 60
        && request.resource.data.actionUrl is string
        && request.resource.data.actionUrl.size() <= 500
        && request.resource.data.tokenReward is int
        && request.resource.data.tokenReward >= 1
        && request.resource.data.tokenReward <= 10000
        && request.resource.data.status in ['Active', 'Paused']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if (isAdmin() || isStaff())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'category', 'platform', 'actionUrl',
          'tokenReward', 'status', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1500
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 60
        && request.resource.data.actionUrl is string
        && request.resource.data.actionUrl.size() <= 500
        && request.resource.data.tokenReward is int
        && request.resource.data.tokenReward >= 1
        && request.resource.data.tokenReward <= 10000
        && request.resource.data.status in ['Active', 'Paused']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /socialTaskSubmissions/{submissionId} {
      allow read: if isAdmin() || isStaff() || (
        signedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'taskId', 'taskTitle', 'userId', 'userName', 'proof', 'tokenReward',
          'status', 'submittedAt', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNote'
        ])
        && request.resource.data.keys().hasOnly([
          'taskId', 'taskTitle', 'userId', 'userName', 'proof', 'tokenReward',
          'status', 'submittedAt', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNote'
        ])
        && request.resource.data.userId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'member'
        && request.resource.data.taskId is string
        && request.resource.data.taskId.size() > 0
        && submissionId == request.resource.data.taskId + '__' + request.auth.uid
        && get(/databases/$(database)/documents/socialTasks/$(request.resource.data.taskId)).data.status == 'Active'
        && request.resource.data.taskTitle == get(/databases/$(database)/documents/socialTasks/$(request.resource.data.taskId)).data.title
        && request.resource.data.userName is string
        && request.resource.data.userName.size() <= 100
        && request.resource.data.proof is string
        && request.resource.data.proof.size() > 0
        && request.resource.data.proof.size() <= 2000
        && request.resource.data.tokenReward == get(/databases/$(database)/documents/socialTasks/$(request.resource.data.taskId)).data.tokenReward
        && request.resource.data.status == 'Pending'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedByName == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewNote == '';
      allow update: if (isAdmin() || isStaff())
        && resource.data.status == 'Pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNote'
        ])
        && request.resource.data.status in ['Approved', 'Rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedByName is string
        && request.resource.data.reviewedByName.size() <= 100
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewNote is string
        && request.resource.data.reviewNote.size() <= 1000
        && (
          request.resource.data.status != 'Approved'
          || (
            getAfter(/databases/$(database)/documents/users/$(resource.data.userId)).data.lastSocialTaskSubmissionId == submissionId
            && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.reputationPoints
              == get(/databases/$(database)/documents/socialTaskBalances/$(resource.data.userId)).data.points
            && getAfter(/databases/$(database)/documents/socialTaskBalances/$(resource.data.userId)).data.points
              == get(/databases/$(database)/documents/socialTaskBalances/$(resource.data.userId)).data.points + resource.data.tokenReward
            && getAfter(/databases/$(database)/documents/users/$(resource.data.userId)).data.reputationPoints
              == getAfter(/databases/$(database)/documents/socialTaskBalances/$(resource.data.userId)).data.points
            && existsAfter(/databases/$(database)/documents/reputationRewards/$(submissionId))
          )
        );
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'Rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'proof', 'status', 'submittedAt', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNote'
        ])
        && request.resource.data.status == 'Pending'
        && request.resource.data.proof is string
        && request.resource.data.proof.size() > 0
        && request.resource.data.proof.size() <= 2000
        && request.resource.data.submittedAt == request.time
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedByName == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewNote == ''
        && get(/databases/$(database)/documents/socialTasks/$(resource.data.taskId)).data.status == 'Active';
      allow delete: if isAdmin();
    }

    match /staffTasks/{taskId} {
      allow read: if isAdmin() || (isStaff() && resource.data.assignedTo == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'title', 'description', 'category', 'priority', 'status', 'assignedTo',
          'assignedBy', 'assignedByName', 'dueAt', 'staffNote', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'priority', 'status', 'assignedTo',
          'assignedBy', 'assignedByName', 'dueAt', 'staffNote', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.priority in ['Urgent', 'High', 'Normal', 'Low']
        && request.resource.data.status == 'Assigned'
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedBy == request.auth.uid
        && request.resource.data.assignedByName is string
        && (request.resource.data.dueAt == null || request.resource.data.dueAt is timestamp)
        && request.resource.data.staffNote == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() || (
        isStaff()
        && resource.data.assignedTo == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'staffNote', 'updatedAt'
        ])
        && request.resource.data.status in ['Assigned', 'In progress', 'Completed']
        && request.resource.data.staffNote is string
        && request.resource.data.staffNote.size() <= 2000
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || isStaff();
      allow update: if isAdmin() || (
        isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'moderationNotes', 'updatedAt'
        ])
        && request.resource.data.status in ['New', 'Under review', 'Resolved', 'Dismissed']
        && request.resource.data.moderationNotes is string
        && request.resource.data.moderationNotes.size() <= 1500
        && request.resource.data.updatedAt == request.time
      );
      allow create, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || isStaff();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'priority', 'adminReply', 'updatedAt'
        ])
        && request.resource.data.status in ['Open', 'In progress', 'Waiting on member', 'Resolved']
        && request.resource.data.priority in ['Low', 'Normal', 'High', 'Urgent']
        && request.resource.data.adminReply is string
        && request.resource.data.adminReply.size() <= 3000
        && request.resource.data.updatedAt == request.time;
      allow create, delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /opportunities/{opportunityId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /learningCourses/{resourceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'Published');
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /earnings/{earningId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.currency is string
        && request.resource.data.earnedAt is timestamp
        && request.resource.data.userId is string;
      allow delete: if isAdmin();
    }

    match /jobAcquisitions/{acquisitionId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.userId is string
        && request.resource.data.jobId is string
        && request.resource.data.acquiredAt is timestamp;
      allow delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'body', 'category', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.category in [
          'General', 'Wins', 'Learning', 'Opportunities', 'Questions', 'Projects'
        ]
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() || (
        signedIn() && resource.data.authorId == request.auth.uid
      );
    }

    match /contentReviews/{postId} {
      allow read: if isAdmin() || isStaff();
      allow create, update: if isAdmin() || (
        isStaff()
        && request.resource.data.keys().hasAll([
          'postId', 'reviewStatus', 'moderationNotes', 'reviewedBy', 'reviewedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'postId', 'reviewStatus', 'moderationNotes', 'reviewedBy', 'reviewedAt'
        ])
        && request.resource.data.postId == postId
        && request.resource.data.reviewStatus in ['Needs review', 'Reviewed', 'Follow-up needed']
        && request.resource.data.moderationNotes is string
        && request.resource.data.moderationNotes.size() <= 1500
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
      );
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || isStaff() || (
        signedIn()
        && resource.data.status in ['Published', 'Scheduled']
        && resource.data.publishAt is timestamp
        && resource.data.publishAt <= request.time
      );
      allow create: if (isAdmin() || isStaff())
        && request.resource.data.keys().hasAll([
          'title', 'body', 'category', 'status', 'publishAt', 'createdBy',
          'createdByName', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'category', 'status', 'publishAt', 'createdBy',
          'createdByName', 'createdAt', 'updatedAt'
        ])
        && announcementFieldsValid(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() || (
        isStaff()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'category', 'status', 'publishAt', 'updatedAt'
        ])
        && announcementFieldsValid(request.resource.data)
        && request.resource.data.updatedAt == request.time
      );
      allow delete: if isAdmin() || (isStaff() && resource.data.createdBy == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'participants', 'participantNames', 'lastMessage', 'lastMessageAt',
          'lastMessageId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && conversationId == request.resource.data.participants[0] + '__' + request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantNames is map
        && request.resource.data.participantNames.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.participantNames[request.auth.uid] == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
        && exists(/databases/$(database)/documents/publicProfiles/$(otherConversationParticipant(request.resource.data.participants)))
        && request.resource.data.participantNames[otherConversationParticipant(request.resource.data.participants)] == get(/databases/$(database)/documents/publicProfiles/$(otherConversationParticipant(request.resource.data.participants))).data.displayName
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastMessageAt == null
        && request.resource.data.lastMessageId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageAt', 'lastMessageId', 'updatedAt'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)).data.body == request.resource.data.lastMessage
        && getAfter(/databases/$(database)/documents/conversations/$(conversationId)/messages/$(request.resource.data.lastMessageId)).data.createdAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.keys().hasOnly(['senderId', 'body', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}

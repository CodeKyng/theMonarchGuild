rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStaff() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function announcementFieldsValid(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.body is string
        && data.body.size() > 0
        && data.body.size() <= 4000
        && data.category in ['Guild update', 'Events', 'Opportunities', 'Community', 'Important']
        && data.status in ['Draft', 'Scheduled', 'Published', 'Archived']
        && (data.publishAt == null || data.publishAt is timestamp)
        && (data.status != 'Scheduled' || (data.publishAt is timestamp && data.publishAt > request.time))
        && (data.status != 'Published' || (data.publishAt is timestamp && data.publishAt <= request.time))
        && (data.status == 'Scheduled' || data.status == 'Published' || data.publishAt == null);
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.role == 'member';
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if signedIn();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /publicLeaderboard/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isOwner(userId);
    }

    match /reputationRewards/{rewardId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /staffTasks/{taskId} {
      allow read: if isAdmin() || (isStaff() && resource.data.assignedTo == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isStaff() && resource.data.assignedTo == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read: if isAdmin() || isStaff();
      allow update: if isAdmin() || isStaff();
      allow create, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || isStaff();
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /opportunities/{opportunityId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /learningCourses/{resourceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.status == 'Published');
      allow create, update, delete: if isAdmin();
    }

    match /earnings/{earningId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /jobAcquisitions/{acquisitionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /contentReviews/{postId} {
      allow read: if isAdmin() || isStaff();
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || isStaff() || signedIn();
      allow create, update, delete: if isAdmin() || isStaff();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn();
      allow update: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if false;
      }
    }

    match /communityTasks/{taskId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.rewardAmount is number
        && request.resource.data.rewardAmount > 0
        && request.resource.data.status == 'Active'
        && request.resource.data.platform in ['X', 'Telegram', 'Other'];
      allow update: if isAdmin() || (
        (isAdmin() || isStaff())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completionCount', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId.size() > 0;
      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /taskSubmissions/{submissionId} {
      allow read: if isAdmin() || isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.taskId is string
        && request.resource.data.walletAddress is string
        && request.resource.data.walletAddress.size() == 42
        && request.resource.data.proofUrl is string
        && request.resource.data.proofUrl.size() > 0
        && request.resource.data.rewardAmount is number
        && request.resource.data.rewardAmount > 0;
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }
  }
}
